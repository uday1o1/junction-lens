{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cpu",
      "displayName": "Native CPU development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpu",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "sanitizers",
      "displayName": "Clang ASan and UBSan native library gate",
      "inherits": "cpu",
      "binaryDir": "${sourceDir}/build/sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "JUNCTIONLENS_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "gpu",
      "displayName": "Linux x86-64 CUDA qualification",
      "inherits": "cpu",
      "binaryDir": "${sourceDir}/build/gpu",
      "cacheVariables": {
        "JUNCTIONLENS_ENABLE_CUDA_RUNTIME": "ON",
        "JUNCTIONLENS_ONNXRUNTIME_ROOT": "${sourceDir}/.tools/onnxruntime-gpu-cpp/1.25.0"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Clang ASan and UBSan parser mutation smoke",
      "inherits": "sanitizers",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_CXX_COMPILER": "clang++",
        "JUNCTIONLENS_ENABLE_FUZZING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cpu",
      "configurePreset": "cpu"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "targets": [
        "junctionlens-geometry-tests",
        "junctionlens-eval-tests",
        "junctionlens-infer-tests"
      ]
    },
    {
      "name": "gpu",
      "configurePreset": "gpu"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "targets": [
        "junctionlens-contract-fuzz-smoke"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "cpu",
      "configurePreset": "cpu",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "filter": {
        "include": {
          "name": "^(geometry|eval|infer)\\."
        }
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gpu",
      "configurePreset": "gpu",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
