{
  "name": "junctionlens",
  "version": "0.1.0",
  "private": true,
  "description": "JunctionLens local evidence viewer",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "22.18.0",
    "pnpm": "10.17.1"
  },
  "scripts": {
    "format:check": "prettier --check package.json pnpm-workspace.yaml web",
    "lock:check": "pnpm install --frozen-lockfile --ignore-scripts",
    "test:contract": "vitest run web/tests/contract-ids.test.ts",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "vite": "7.1.3"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
