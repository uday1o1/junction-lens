FROM docker.io/library/python@sha256:314bc2fb0714b7807bf5699c98f0c73817e579799f2d91567ab7e9510f5601a5

ARG SOURCE_DATE_EPOCH=1698810385

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=0 \
    PYTHONPATH=/opt/openlane-v2:/opt/junctionlens \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

COPY evaluator-requirements.lock /opt/build/evaluator-requirements.lock

RUN python -m pip install \
        --disable-pip-version-check \
        --no-cache-dir \
        --only-binary=:all: \
        --require-hashes \
        --requirement /opt/build/evaluator-requirements.lock \
    && python -m pip check \
    && rm -rf /opt/build/evaluator-requirements.lock /root/.cache

COPY openlane-v2-v2.1.0.tar.gz /opt/build/openlane-v2-v2.1.0.tar.gz

RUN mkdir -p /opt/openlane-v2 \
    && tar -xzf /opt/build/openlane-v2-v2.1.0.tar.gz --strip-components=1 -C /opt/openlane-v2 \
    && rm /opt/build/openlane-v2-v2.1.0.tar.gz \
    && test "$(sha256sum /opt/openlane-v2/openlanev2/lanesegment/evaluation/evaluate.py | cut -d ' ' -f 1)" = "214918bcb26db69ed25664922d6e62d59cb522cffbe73b8ccb8609ad02ca5c7e"

COPY evaluator_payload.py evaluator_runner.py /opt/junctionlens/

LABEL org.opencontainers.image.source="https://github.com/OpenDriveLab/OpenLane-V2" \
      org.opencontainers.image.version="2.1.0" \
      org.opencontainers.image.revision="d731a26bdbf34723dd915ad525c2c2eca19ed8a1" \
      org.junctionlens.evaluator.ortools-deviation="9.3.10497-replaces-deleted-9.2.9972" \
      org.junctionlens.evaluator.opencv-deviation="opencv-python-headless-5.0.0.93"

USER 65532:65532
ENTRYPOINT ["python", "/opt/junctionlens/evaluator_runner.py"]
