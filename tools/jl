#!/bin/sh
set -eu

JL_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
JL_PATH="$JL_ROOT/.tools/bin:$JL_ROOT/.venv/bin:$PATH"
export PATH="$JL_PATH"
UV_CACHE_DIR="$JL_ROOT/.cache/uv"
export UV_CACHE_DIR

usage() {
  cat <<'EOF'
Usage: ./tools/jl <command>

Repository commands:
  bootstrap-cpu
  configure-cpu
  build-cpu
  doctor
  format-check
  lint
  typecheck
  test-cpp
  test-python
  test-contract
  generate-bindings
  test-web
  build-evaluator [--check-lock]
  test-evaluator
  verify-locks [--online]
  verify-m0-1
  verify-m0-2-local
  model-overfit [--steps N]
  model-export
  model-parity
  model-providers
  model-benchmark
  verify-m0-3-local
  verify-m1-1
EOF
}

if [ "$#" -eq 0 ]; then
  usage
  exit 2
fi

JL_COMMAND=$1
shift

case "$JL_COMMAND" in
  bootstrap-cpu)
    python3 "$JL_ROOT/scripts/bootstrap/bootstrap_cpu.py" "$@"
    ;;
  configure-cpu)
    cmake --preset cpu "$@"
    ;;
  build-cpu)
    cmake --build --preset cpu "$@"
    ;;
  doctor)
    uv run --locked junctionlens doctor "$@"
    ;;
  format-check)
    uv run --locked ruff format --check python tests scripts containers/evaluator_runner.py
    pnpm run format:check
    ;;
  lint)
    uv run --locked ruff check python tests scripts containers/evaluator_runner.py
    ;;
  typecheck)
    uv run --locked mypy
    ;;
  test-cpp)
    ctest --preset cpu "$@"
    ;;
  test-python)
    uv run --locked pytest "$@"
    ;;
  test-contract)
    uv run --locked pytest tests/contract "$@"
    ;;
  generate-bindings)
    python scripts/contracts/generate_bindings.py --python "$@"
    ;;
  test-web)
    pnpm run typecheck:web
    pnpm run test:contract
    ;;
  build-evaluator)
    uv run --locked python scripts/containers/build_evaluator.py "$@"
    ;;
  test-evaluator)
    uv run --locked python scripts/containers/verify_evaluator.py "$@"
    ;;
  verify-locks)
    uv run --locked python -m junctionlens.locks.verify "$@"
    ;;
  model-overfit)
    uv run --locked junctionlens model micro-overfit "$@"
    ;;
  model-export)
    uv run --locked junctionlens model export "$@"
    ;;
  model-parity)
    uv run --locked junctionlens model parity "$@"
    ;;
  model-providers)
    uv run --locked junctionlens model probe-providers "$@"
    ;;
  model-benchmark)
    uv run --locked junctionlens model benchmark-m0 "$@"
    ;;
  verify-m0-1)
    uv lock --check
    uv sync --locked --extra cpu --extra analytics --extra service
    CI=true pnpm install --frozen-lockfile --ignore-scripts
    "$0" configure-cpu
    "$0" build-cpu
    "$0" format-check
    "$0" lint
    "$0" typecheck
    "$0" verify-locks
    "$0" test-cpp
    "$0" test-python
    "$0" doctor --json
    ;;
  verify-m0-2-local)
    "$0" verify-m0-1
    "$0" build-evaluator --check-lock
    "$0" test-evaluator
    ;;
  verify-m0-3-local)
    "$0" verify-m0-2-local
    "$0" model-overfit
    "$0" model-export
    "$0" build-cpu
    "$0" model-parity
    "$0" model-providers
    "$0" test-evaluator --output "$JL_ROOT/artifacts/m0/model-spike/evaluator.json"
    "$0" model-benchmark
    ;;
  verify-m1-1)
    "$0" generate-bindings
    "$0" configure-cpu
    "$0" build-cpu
    "$0" format-check
    "$0" lint
    "$0" typecheck
    "$0" test-cpp
    "$0" test-python
    "$0" test-web
    junctionlens contract validate --input "$JL_ROOT/tests/fixtures/contract/v1/golden.pb"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $JL_COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
