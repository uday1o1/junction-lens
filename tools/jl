#!/bin/sh
set -eu

JL_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
JL_PATH="$JL_ROOT/.tools/bin:$JL_ROOT/.venv/bin:$PATH"
export PATH="$JL_PATH"
UV_CACHE_DIR="$JL_ROOT/.cache/uv"
export UV_CACHE_DIR

usage() {
  cat <<'EOF'
Usage: ./tools/jl <command>

Repository commands:
  bootstrap-cpu
  configure-cpu
  configure-sanitizers
  build-cpu
  build-sanitizers
  doctor
  format-cpp-check
  format-check
  lint
  typecheck
  test-cpp
  test-sanitizers
  test-python
  test-contract
  generate-bindings
  generate-synthetic [--output DIR]
  verify-synthetic [--root DIR]
  test-integration-synthetic
  test-integration-data
  test-integration-splits
  test-integration-audit
  test-integration-evaluator
  test-integration-custom-kpis
  test-integration-evidence
  test-integration-e0
  test-integration-gate
  test-integration-topology
  test-integration-e1-study
  test-web
  build-evaluator [--check-lock]
  test-evaluator
  verify-locks [--online]
  verify-m0-1
  verify-m0-2-local
  model-overfit [--steps N]
  model-export
  model-parity
  model-providers
  model-benchmark
  model-topology
  verify-m0-3-local
  verify-m1-1
  verify-m1-2
  verify-m1-3
  verify-m2-1-local
  verify-m2-2-local
  verify-m2-3-local
  verify-m3-1
  verify-m3-2
  verify-m3-3
  verify-m4-1-local
  verify-m4-2-local
  verify-m5-1-local
  verify-m5-2-local
EOF
}

if [ "$#" -eq 0 ]; then
  usage
  exit 2
fi

JL_COMMAND=$1
shift

case "$JL_COMMAND" in
  bootstrap-cpu)
    python3 "$JL_ROOT/scripts/bootstrap/bootstrap_cpu.py" "$@"
    ;;
  configure-cpu)
    cmake --preset cpu "$@"
    ;;
  configure-sanitizers)
    cmake --preset sanitizers "$@"
    ;;
  build-cpu)
    cmake --build --preset cpu "$@"
    ;;
  build-sanitizers)
    cmake --build --preset sanitizers "$@"
    ;;
  doctor)
    uv run --locked junctionlens doctor "$@"
    ;;
  format-cpp-check)
    if command -v clang-format >/dev/null 2>&1; then
      JL_CLANG_FORMAT=$(command -v clang-format)
    elif command -v xcrun >/dev/null 2>&1 && xcrun --find clang-format >/dev/null 2>&1; then
      JL_CLANG_FORMAT=$(xcrun --find clang-format)
    else
      echo "clang-format is required for the native formatting gate" >&2
      exit 2
    fi
    find "$JL_ROOT/cpp" -type f \( -name '*.cpp' -o -name '*.hpp' \) \
      -exec "$JL_CLANG_FORMAT" --dry-run --Werror {} +
    ;;
  format-check)
    uv run --locked ruff format --check \
      python tests scripts containers/evaluator_runner.py containers/adapter_parity_runner.py \
      containers/custom_match.py
    "$0" format-cpp-check
    pnpm run format:check
    ;;
  lint)
    uv run --locked ruff check \
      python tests scripts containers/evaluator_runner.py containers/adapter_parity_runner.py \
      containers/custom_match.py
    ;;
  typecheck)
    uv run --locked mypy
    ;;
  test-cpp)
    ctest --preset cpu "$@"
    ;;
  test-sanitizers)
    ctest --preset sanitizers "$@"
    ;;
  test-python)
    uv run --locked pytest "$@"
    ;;
  test-contract)
    uv run --locked pytest tests/contract "$@"
    ;;
  generate-bindings)
    python scripts/contracts/generate_bindings.py --python "$@"
    ;;
  generate-synthetic)
    if [ "$#" -eq 0 ]; then
      uv run --locked junctionlens synthetic generate --output "$JL_ROOT/artifacts/synthetic"
    else
      uv run --locked junctionlens synthetic generate "$@"
    fi
    ;;
  verify-synthetic)
    if [ "$#" -eq 0 ]; then
      uv run --locked junctionlens synthetic verify \
        --root "$JL_ROOT/tests/fixtures/synthetic/v1"
    else
      uv run --locked junctionlens synthetic verify "$@"
    fi
    ;;
  test-integration-synthetic)
    uv run --locked pytest \
      "$JL_ROOT/tests/unit/test_synthetic_generator.py" \
      "$JL_ROOT/tests/integration/test_synthetic_cli.py" \
      "$@"
    ;;
  test-integration-data)
    uv run --locked pytest \
      "$JL_ROOT/tests/unit/test_openlane_adapter.py" \
      "$JL_ROOT/tests/unit/test_openlane_parity.py" \
      "$JL_ROOT/tests/security/test_adapter_parity_container.py" \
      "$JL_ROOT/tests/integration/test_data_cli.py" \
      "$@"
    ;;
  test-integration-splits)
    uv run --locked pytest \
      "$JL_ROOT/tests/unit/test_data_manifests.py" \
      "$JL_ROOT/tests/unit/test_registry_store.py" \
      "$JL_ROOT/tests/integration/test_split_cli.py" \
      "$@"
    ;;
  test-integration-audit)
    uv run --locked pytest \
      "$JL_ROOT/tests/unit/test_visual_audit.py" \
      "$JL_ROOT/tests/integration/test_visual_audit_cli.py" \
      "$@"
    ;;
  test-integration-evaluator)
    uv run --locked pytest \
      "$JL_ROOT/tests/unit/test_evaluator_payload.py" \
      "$JL_ROOT/tests/security/test_evaluator_container.py" \
      "$@"
    ;;
  test-integration-custom-kpis)
    uv run --locked pytest \
      "$JL_ROOT/tests/unit/test_custom_kpis.py" \
      "$JL_ROOT/tests/security/test_custom_match.py" \
      "$@"
    uv run --locked python "$JL_ROOT/scripts/evaluator/verify_custom_kpis.py"
    ;;
  test-integration-evidence)
    uv run --locked pytest \
      "$JL_ROOT/tests/unit/test_evidence_metrics.py" \
      "$JL_ROOT/tests/integration/test_evidence_cli.py" \
      "$@"
    ;;
  test-integration-e0)
    uv run --locked pytest \
      "$JL_ROOT/tests/unit/test_e0_baseline.py" \
      "$JL_ROOT/tests/integration/test_e0_cli.py" \
      "$@"
    ;;
  test-integration-gate)
    uv run --locked pytest \
      "$JL_ROOT/tests/unit/test_gate_bootstrap.py" \
      "$JL_ROOT/tests/unit/test_gate_charter.py" \
      "$JL_ROOT/tests/unit/test_gate_decision.py" \
      "$JL_ROOT/tests/integration/test_gate_cli.py" \
      "$@"
    ;;
  test-integration-topology)
    uv run --locked pytest \
      "$JL_ROOT/tests/unit/test_learned_topology.py" \
      "$JL_ROOT/tests/integration/test_topology_cli.py" \
      "$@"
    ;;
  test-integration-e1-study)
    uv run --locked pytest \
      "$JL_ROOT/tests/unit/test_e1_study.py" \
      "$JL_ROOT/tests/integration/test_e1_study_cli.py" \
      "$@"
    ;;
  test-web)
    pnpm run typecheck:web
    pnpm run test:contract
    ;;
  build-evaluator)
    uv run --locked python scripts/containers/build_evaluator.py "$@"
    ;;
  test-evaluator)
    uv run --locked python scripts/containers/verify_evaluator.py "$@"
    ;;
  verify-locks)
    uv run --locked python -m junctionlens.locks.verify "$@"
    ;;
  model-overfit)
    uv run --locked junctionlens model micro-overfit "$@"
    ;;
  model-export)
    uv run --locked junctionlens model export "$@"
    ;;
  model-parity)
    uv run --locked junctionlens model parity "$@"
    ;;
  model-providers)
    uv run --locked junctionlens model probe-providers "$@"
    ;;
  model-benchmark)
    uv run --locked junctionlens model benchmark-m0 "$@"
    ;;
  model-topology)
    uv run --locked junctionlens model verify-topology "$@"
    ;;
  verify-m0-1)
    uv lock --check
    uv sync --locked --extra cpu --extra analytics --extra service
    CI=true pnpm install --frozen-lockfile --ignore-scripts
    "$0" configure-cpu
    "$0" build-cpu
    "$0" format-check
    "$0" lint
    "$0" typecheck
    "$0" verify-locks
    "$0" test-cpp
    "$0" test-python
    "$0" doctor --json
    ;;
  verify-m0-2-local)
    "$0" verify-m0-1
    "$0" build-evaluator --check-lock
    "$0" test-evaluator
    ;;
  verify-m0-3-local)
    "$0" verify-m0-2-local
    "$0" model-overfit
    "$0" model-export
    "$0" build-cpu
    "$0" model-parity
    "$0" model-providers
    "$0" test-evaluator --output "$JL_ROOT/artifacts/m0/model-spike/evaluator.json"
    "$0" model-benchmark
    ;;
  verify-m1-1)
    "$0" generate-bindings
    "$0" configure-cpu
    "$0" build-cpu
    "$0" format-check
    "$0" lint
    "$0" typecheck
    "$0" test-cpp
    "$0" test-python
    "$0" test-web
    junctionlens contract validate --input "$JL_ROOT/tests/fixtures/contract/v1/golden.pb"
    ;;
  verify-m1-2)
    "$0" verify-m1-1
    "$0" configure-sanitizers
    "$0" build-sanitizers
    "$0" test-sanitizers
    ;;
  verify-m1-3)
    "$0" verify-m1-2
    "$0" test-integration-synthetic
    "$0" verify-synthetic
    ;;
  verify-m2-1-local)
    "$0" verify-m1-3
    "$0" verify-locks
    "$0" test-integration-data
    ;;
  verify-m2-2-local)
    "$0" verify-m2-1-local
    "$0" verify-locks
    "$0" test-integration-splits
    ;;
  verify-m2-3-local)
    "$0" verify-m2-2-local
    "$0" verify-locks
    "$0" test-integration-audit
    ;;
  verify-m3-1)
    "$0" verify-m2-3-local
    "$0" build-evaluator --check-lock
    "$0" test-integration-evaluator
    "$0" test-evaluator
    ;;
  verify-m3-2)
    "$0" verify-m3-1
    "$0" test-integration-custom-kpis
    ;;
  verify-m3-3)
    "$0" verify-m3-2
    "$0" test-integration-evidence
    ;;
  verify-m4-1-local)
    "$0" verify-m3-3
    "$0" test-integration-e0
    ;;
  verify-m4-2-local)
    "$0" verify-m4-1-local
    "$0" test-integration-gate
    ;;
  verify-m5-1-local)
    "$0" verify-m4-2-local
    "$0" test-integration-topology
    ;;
  verify-m5-2-local)
    "$0" verify-m5-1-local
    "$0" test-integration-e1-study
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $JL_COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
